  },
  "dependencies": {
    "@saas/database": "workspace:*",
    "@saas/identity-access": "workspace:*",
    "@saas/merchant": "workspace:*",
    "@nestjs/common": "11.2.1",
    "@nestjs/core": "11.2.1",
    "@nestjs/platform-express": "11.2.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "^7.8.2"
  }
}
