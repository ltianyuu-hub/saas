  updatedAt                DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  merchant                 Merchant                @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  brand                    Brand                   @relation(fields: [brandId, merchantId], references: [id, merchantId], onDelete: Restrict)
  order                    Order                   @relation(fields: [orderId, merchantId], references: [id, merchantId], onDelete: Restrict)
  orderItem                OrderItem               @relation(fields: [orderItemId, merchantId], references: [id, merchantId], onDelete: Restrict)
  campaign                 GroupBuyCampaign        @relation(fields: [campaignId, merchantId], references: [id, merchantId], onDelete: Restrict)
  campaignVersion          GroupBuyCampaignVersion @relation(fields: [campaignVersionId, merchantId], references: [id, merchantId], onDelete: Restrict)
  productVersion           ProductVersion          @relation(fields: [productVersionId, merchantId], references: [id, merchantId], onDelete: Restrict)
  purchaser                Consumer                @relation("VoucherPurchaser", fields: [purchaserConsumerId], references: [id], onDelete: Restrict)
  holder                   Consumer                @relation("VoucherHolder", fields: [holderConsumerId], references: [id], onDelete: Restrict)
  redeemedStore            Store?                  @relation("VoucherRedeemedStore", fields: [redeemedStoreId, merchantId], references: [id, merchantId], onDelete: Restrict)
  redemptions              Redemption[]
  redemptionReversals      RedemptionReversal[]
  refundItems              RefundItem[]

  @@unique([orderItemId, issuedSequence])
  @@unique([id, merchantId])
  @@index([merchantId, holderConsumerId, status])
  @@index([merchantId, campaignId, status])
  @@index([redeemCodeHash])
  @@map("voucher")
}

model Redemption {
  id             String               @id @default(uuid()) @db.Uuid
  redemptionNo   String               @unique @map("redemption_no")
  merchantId     String               @map("merchant_id") @db.Uuid
  voucherId      String               @map("voucher_id") @db.Uuid
  orderId        String               @map("order_id") @db.Uuid
  storeId        String               @map("store_id") @db.Uuid
  staffId        String               @map("staff_id") @db.Uuid
  redeemMethod   RedemptionMethod     @map("redeem_method")
  status         RedemptionStatus
  requestId      String               @map("request_id")
  idempotencyKey String               @map("idempotency_key")
  startedAt      DateTime             @default(now()) @map("started_at") @db.Timestamptz(6)
  confirmedAt    DateTime?            @map("confirmed_at") @db.Timestamptz(6)
  failedAt       DateTime?            @map("failed_at") @db.Timestamptz(6)
  merchant       Merchant             @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  voucher        Voucher              @relation(fields: [voucherId, merchantId], references: [id, merchantId], onDelete: Restrict)
  order          Order                @relation(fields: [orderId, merchantId], references: [id, merchantId], onDelete: Restrict)
  store          Store                @relation(fields: [storeId, merchantId], references: [id, merchantId], onDelete: Restrict)
  staff          Staff                @relation(fields: [staffId, merchantId], references: [id, merchantId], onDelete: Restrict)
  reversals      RedemptionReversal[]

  @@unique([merchantId, idempotencyKey])
  @@unique([voucherId], map: "redemption_voucher_success_key", where: raw("status = 'SUCCESS'"))
  @@unique([id, merchantId])
  @@index([merchantId, storeId, confirmedAt])
  @@map("redemption")
}

model RedemptionReversal {
  id              String     @id @default(uuid()) @db.Uuid
  merchantId      String     @map("merchant_id") @db.Uuid
  redemptionId    String     @map("redemption_id") @db.Uuid
  voucherId       String     @map("voucher_id") @db.Uuid
  requestedByType String     @map("requested_by_type")
  requestedById   String     @map("requested_by_id") @db.Uuid
  approvedByType  String?    @map("approved_by_type")
  approvedById    String?    @map("approved_by_id") @db.Uuid
  reasonCode      String     @map("reason_code")
  reasonText      String?    @map("reason_text")
  status          String
  requestedAt     DateTime   @default(now()) @map("requested_at") @db.Timestamptz(6)
  approvedAt      DateTime?  @map("approved_at") @db.Timestamptz(6)
  completedAt     DateTime?  @map("completed_at") @db.Timestamptz(6)
  rejectedAt      DateTime?  @map("rejected_at") @db.Timestamptz(6)
  merchant        Merchant   @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  redemption      Redemption @relation(fields: [redemptionId, merchantId], references: [id, merchantId], onDelete: Restrict)
  voucher         Voucher    @relation(fields: [voucherId, merchantId], references: [id, merchantId], onDelete: Restrict)

  @@index([merchantId, status, requestedAt])
  @@map("redemption_reversal")
}

model Refund {
  id               String        @id @default(uuid()) @db.Uuid
  refundNo         String        @unique @map("refund_no")
  merchantId       String        @map("merchant_id") @db.Uuid
  orderId          String        @map("order_id") @db.Uuid
  paymentId        String        @map("payment_id") @db.Uuid
  consumerId       String        @map("consumer_id") @db.Uuid
  refundType       RefundType    @map("refund_type")
  status           RefundStatus
  amount           BigInt        @db.BigInt
  currency         String        @db.Char(3)
  reasonCode       String        @map("reason_code")
  reasonText       String?       @map("reason_text")
  providerRefundId String?       @unique @map("provider_refund_id")
  requestedByType  String        @map("requested_by_type")
  requestedById    String        @map("requested_by_id") @db.Uuid
  approvedByType   String?       @map("approved_by_type")
  approvedById     String?       @map("approved_by_id") @db.Uuid
  idempotencyKey   String        @map("idempotency_key")
  version          Int           @default(1)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  succeededAt      DateTime?     @map("succeeded_at") @db.Timestamptz(6)
  merchant         Merchant      @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  order            Order         @relation(fields: [orderId, merchantId], references: [id, merchantId], onDelete: Restrict)
  payment          Payment       @relation(fields: [paymentId, orderId, merchantId], references: [id, orderId, merchantId], onDelete: Restrict, map: "refund_payment_order_merchant_fkey")
  consumer         Consumer      @relation(fields: [consumerId], references: [id], onDelete: Restrict)
  items            RefundItem[]
  feeReversals     FeeReversal[]

  @@unique([merchantId, idempotencyKey])
  @@unique([id, merchantId])
  @@index([merchantId, paymentId, status])
  @@index([merchantId, status, createdAt])
  @@map("refund")
}

