generator client {
  provider        = "prisma-client"
  output          = "../packages/database/src/generated/prisma"
  moduleFormat    = "cjs"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum MerchantStatus {
  PENDING_SETUP
  ACTIVE
  SUSPENDED
  FROZEN
  TERMINATED
}

enum StoreStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum StaffStatus {
  PENDING
  ACTIVE
  SUSPENDED
  LEFT
}

enum StaffStoreAssignmentStatus {
  ACTIVE
  DISABLED
}

enum PlatformAdminStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum AuthSessionActorType {
  CONSUMER
  STAFF
  PLATFORM
}

enum AuthSessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum MiniProgramConfigStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum MiniProgramReleaseJobStatus {
  PENDING
  COMMITTING
  EXPERIENCE_READY
  AUDIT_SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  RELEASING
  RELEASED
  FAILED
}

enum ProductType {
  GROUP_BUY
}

enum CampaignStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  ACTIVE
  PAUSED
  ENDED
  TERMINATION_REQUESTED
  TERMINATED
}

enum UsageRuleType {
  FIXED_RANGE
  AFTER_PURCHASE
}

enum InventoryMode {
  LIMITED
  UNLIMITED
}

enum InventoryScope {
  CAMPAIGN
}

enum InventoryReservationStatus {
  ACTIVE
  CONSUMED
  RELEASED
}

enum InventoryAdjustmentType {
  MANUAL_INCREASE
  MANUAL_DECREASE
  SYSTEM_RESTORE
  SYSTEM_CORRECTION
}

enum OrderType {
  GROUP_BUY
}

enum OrderStatus {
  PENDING_PAYMENT
  PAYMENT_CONFIRMING
  PAID
  FULFILLING
  FULFILLED
  CLOSED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum PaymentStatus {
  CREATED
  PROCESSING
  CONFIRMING
  SUCCESS
  FAILED
  CLOSED
  EXCEPTION
}

enum VoucherStatus {
  UNUSED
  REDEEMING
  REDEEMED
  REFUNDING
  REFUNDED
  EXPIRED
  VOID
  REDEEM_REVERSAL_PENDING
}

enum VoucherStatusBeforeRefund {
  UNUSED
  EXPIRED
  REDEEMED
}

enum RedemptionMethod {
  QR
  CODE
}

enum RedemptionStatus {
  PROCESSING
  SUCCESS
  FAILED
}

enum RefundType {
  NORMAL
  EXPIRED_VOUCHER
  DUPLICATE_PAYMENT
  POST_REDEMPTION_EXCEPTION
  MERCHANT_CLEARING
}

enum RefundStatus {
  REQUESTED
  POLICY_CHECKING
  MANUAL_REVIEW
  APPROVED
  PROCESSING
  CONFIRMING
  SUCCESS
  FAILED
  REJECTED
}

enum EventOutboxStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
  DEAD_LETTER
}

enum RiskScene {
  PRE_ORDER
  PRE_PAYMENT
  POST_PAYMENT
  REFUND
  REDEMPTION
  MERCHANT
  REVIEW
}

enum RiskAction {
  ALLOW
  REVIEW
  BLOCK
  ESCALATE
}

enum ExceptionType {
  PAYMENT_MISMATCH
  DUPLICATE_PAYMENT
  PAYMENT_CONFIRM_TIMEOUT
  VOUCHER_ISSUE_FAILED
  VOUCHER_COUNT_MISMATCH
  VOUCHER_OVER_ISSUED
  REFUND_CONFIRM_TIMEOUT
  REFUND_STATE_MISMATCH
  INVENTORY_MISMATCH
  INVENTORY_RESERVATION_LEAK
  REDEMPTION_STATE_MISMATCH
  FEE_CALCULATION_ERROR
  RECONCILIATION_ERROR
}

enum ReconciliationType {
  PAYMENT_ORDER
  REFUND_VOUCHER
  ORDER_VOUCHER
  INVENTORY_ORDER
  FEE_SETTLEMENT
}

enum IntegrationHealthStatus {
  UNKNOWN
  HEALTHY
  DEGRADED
  ERROR
}

model Merchant {
  id                   String                      @id @default(uuid()) @db.Uuid
  merchantCode         String                      @unique @map("merchant_code")
  displayName          String                      @map("display_name")
  legalEntityName      String                      @map("legal_entity_name")
  businessLicenseNo    String?                     @map("business_license_no")
  contactName          String                      @map("contact_name")
  contactPhone         String                      @map("contact_phone")
  status               MerchantStatus
  createdAt            DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(6)
  brands               Brand[]
  stores               Store[]
  roles                Role[]
  staff                Staff[]
  merchantConsumers    MerchantConsumer[]
  capability           MerchantCapability?
  miniProgramAccounts  MiniProgramAccount[]
  miniProgramConfigs   MiniProgramConfig[]
  paymentAccounts      PaymentAccount[]
  products             Product[]
  campaigns            GroupBuyCampaign[]
  campaignVersions     GroupBuyCampaignVersion[]
  inventories          Inventory[]
  reservations         InventoryReservation[]
  inventoryAdjustments InventoryAdjustment[]
  orders               Order[]
  orderItems           OrderItem[]
  payments             Payment[]
  callbacks            IntegrationCallbackRecord[]
  feeRecords           FeeRecord[]
  feeReversals         FeeReversal[]
  fulfillmentRecords   FulfillmentRecord[]
  vouchers             Voucher[]
  redemptions          Redemption[]
  redemptionReversals  RedemptionReversal[]
  refunds              Refund[]
  refundItems          RefundItem[]
  orderEvents          OrderEvent[]
  outboxEvents         EventOutbox[]
  riskEvents           RiskEvent[]
  exceptionRecords     ExceptionRecord[]
  auditLogs            AuditLog[]
  securityEvents       SecurityEvent[]
  releaseJobs          MiniProgramReleaseJob[]
  disputeCases         DisputeCase[]
  riskInvestigations   MerchantRiskInvestigation[]
  clearingCases        MerchantClearingCase[]
  integrationHealth    IntegrationHealth[]

  @@map("merchant")
}

model Brand {
  id                  String               @id @default(uuid()) @db.Uuid
  merchantId          String               @map("merchant_id") @db.Uuid
  brandCode           String               @map("brand_code")
  name                String
  logoFileId          String?              @map("logo_file_id") @db.Uuid
  status              String
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  merchant            Merchant             @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  stores              Store[]
  miniProgramAccounts MiniProgramAccount[]
  miniProgramConfigs  MiniProgramConfig[]
  paymentAccounts     PaymentAccount[]
  products            Product[]
  campaigns           GroupBuyCampaign[]
  orders              Order[]
  vouchers            Voucher[]

  @@unique([merchantId, brandCode])
  @@unique([id, merchantId])
  @@index([merchantId, status])
  @@map("brand")
}

model Store {
  id                String                 @id @default(uuid()) @db.Uuid
  merchantId        String                 @map("merchant_id") @db.Uuid
  brandId           String                 @map("brand_id") @db.Uuid
  storeCode         String                 @map("store_code")
  name              String
  address           String
  longitude         Decimal?               @db.Decimal(10, 7)
  latitude          Decimal?               @db.Decimal(10, 7)
  contactPhone      String?                @map("contact_phone")
  businessHoursJson Json?                  @map("business_hours_json") @db.JsonB
  status            StoreStatus
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  merchant          Merchant               @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  brand             Brand                  @relation(fields: [brandId, merchantId], references: [id, merchantId], onDelete: Restrict)
  primaryStaff      Staff[]
  staffAssignments  StaffStoreAssignment[]
  campaignStores    CampaignStore[]
  redeemedVouchers  Voucher[]              @relation("VoucherRedeemedStore")
  redemptions       Redemption[]

  @@unique([merchantId, storeCode])
  @@unique([id, merchantId])
  @@index([merchantId, brandId, status])
  @@map("store")
}

model Permission {
  id              String           @id @default(uuid()) @db.Uuid
  permissionCode  String           @unique @map("permission_code")
  name            String
  description     String?
  rolePermissions RolePermission[]

  @@map("permission")
}

model Role {
  id              String           @id @default(uuid()) @db.Uuid
  merchantId      String?          @map("merchant_id") @db.Uuid
  roleCode        String           @map("role_code")
  name            String
  description     String?
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  merchant        Merchant?        @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  rolePermissions RolePermission[]
  staff           Staff[]
  platformAdmins  PlatformAdmin[]

  @@unique([id, merchantId])
  @@unique([roleCode], map: "role_platform_code_key", where: raw("merchant_id IS NULL"))
  @@unique([merchantId, roleCode], map: "role_merchant_code_key", where: raw("merchant_id IS NOT NULL"))
  @@map("role")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@map("role_permission")
}

model Staff {
  id                String                 @id @default(uuid()) @db.Uuid
  merchantId        String                 @map("merchant_id") @db.Uuid
  primaryStoreId    String?                @map("primary_store_id") @db.Uuid
  roleId            String                 @map("role_id") @db.Uuid
  staffCode         String                 @map("staff_code")
  displayName       String                 @map("display_name")
  status            StaffStatus
  permissionVersion Int                    @default(1) @map("permission_version")
  version           Int                    @default(1)
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  merchant          Merchant               @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  primaryStore      Store?                 @relation(fields: [primaryStoreId, merchantId], references: [id, merchantId], onDelete: Restrict)
  role              Role                   @relation(fields: [roleId, merchantId], references: [id, merchantId], onDelete: Restrict)
  identities        StaffIdentity[]
  storeAssignments  StaffStoreAssignment[]
  authSessions      AuthSession[]
  redemptions       Redemption[]

  @@unique([merchantId, staffCode])
  @@unique([id, merchantId])
  @@index([merchantId, status])
  @@map("staff")
}

model StaffStoreAssignment {
  id         String                     @id @default(uuid()) @db.Uuid
  merchantId String                     @map("merchant_id") @db.Uuid
  staffId    String                     @map("staff_id") @db.Uuid
  storeId    String                     @map("store_id") @db.Uuid
  status     StaffStoreAssignmentStatus
  createdAt  DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)
  staff      Staff                      @relation(fields: [staffId, merchantId], references: [id, merchantId], onDelete: Restrict)
  store      Store                      @relation(fields: [storeId, merchantId], references: [id, merchantId], onDelete: Restrict)

  @@unique([staffId, storeId])
  @@index([merchantId, staffId, status])
  @@index([merchantId, storeId, status])
  @@map("staff_store_assignment")
}

model StaffIdentity {
  id                String   @id @default(uuid()) @db.Uuid
  staffId           String   @map("staff_id") @db.Uuid
  provider          String
  appId             String   @map("app_id")
  providerSubjectId String   @map("provider_subject_id")
  status            String
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  staff             Staff    @relation(fields: [staffId], references: [id], onDelete: Restrict)

  @@unique([provider, appId, providerSubjectId])
  @@index([staffId, status])
  @@map("staff_identity")
}

model Consumer {
  id                 String             @id @default(uuid()) @db.Uuid
  status             String
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  externalIdentities ExternalIdentity[]
  merchants          MerchantConsumer[]
  orders             Order[]
  payments           Payment[]
  purchasedVouchers  Voucher[]          @relation("VoucherPurchaser")
  heldVouchers       Voucher[]          @relation("VoucherHolder")
  refunds            Refund[]
  authSessions       AuthSession[]

  @@map("consumer")
}

model PlatformAdmin {
  id                String                  @id @default(uuid()) @db.Uuid
  adminCode         String                  @unique @map("admin_code")
  displayName       String                  @map("display_name")
  status            PlatformAdminStatus
  roleId            String                  @map("role_id") @db.Uuid
  permissionVersion Int                     @default(1) @map("permission_version")
  createdAt         DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  role              Role                    @relation(fields: [roleId], references: [id], onDelete: Restrict)
  identities        PlatformAdminIdentity[]
  authSessions      AuthSession[]

  @@index([status])
  @@map("platform_admin")
}

model PlatformAdminIdentity {
  id                String        @id @default(uuid()) @db.Uuid
  platformAdminId   String        @map("platform_admin_id") @db.Uuid
  provider          String
  providerSubjectId String        @map("provider_subject_id")
  status            String
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  platformAdmin     PlatformAdmin @relation(fields: [platformAdminId], references: [id], onDelete: Restrict)

  @@unique([provider, providerSubjectId])
  @@index([platformAdminId, status])
  @@map("platform_admin_identity")
}

model AuthSession {
  id                        String               @id @default(uuid()) @db.Uuid
  actorType                 AuthSessionActorType @map("actor_type")
  consumerId                String?              @map("consumer_id") @db.Uuid
  staffId                   String?              @map("staff_id") @db.Uuid
  platformAdminId           String?              @map("platform_admin_id") @db.Uuid
  tokenHash                 String               @unique @map("token_hash")
  status                    AuthSessionStatus
  permissionVersionSnapshot Int                  @map("permission_version_snapshot")
  issuedAt                  DateTime             @map("issued_at") @db.Timestamptz(6)
  expiresAt                 DateTime             @map("expires_at") @db.Timestamptz(6)
  revokedAt                 DateTime?            @map("revoked_at") @db.Timestamptz(6)
  lastSeenAt                DateTime?            @map("last_seen_at") @db.Timestamptz(6)
  createdAt                 DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  consumer                  Consumer?            @relation(fields: [consumerId], references: [id], onDelete: Restrict)
  staff                     Staff?               @relation(fields: [staffId], references: [id], onDelete: Restrict)
  platformAdmin             PlatformAdmin?       @relation(fields: [platformAdminId], references: [id], onDelete: Restrict)

  @@index([actorType, status, expiresAt])
  @@index([consumerId, status])
  @@index([staffId, status])
  @@index([platformAdminId, status])
  @@map("auth_session")
}

model ExternalIdentity {
  id                String   @id @default(uuid()) @db.Uuid
  consumerId        String   @map("consumer_id") @db.Uuid
  provider          String
  appId             String   @map("app_id")
  providerSubjectId String   @map("provider_subject_id")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  consumer          Consumer @relation(fields: [consumerId], references: [id], onDelete: Restrict)

  @@unique([provider, appId, providerSubjectId])
  @@index([consumerId])
  @@map("external_identity")
}

model MerchantConsumer {
  id          String   @id @default(uuid()) @db.Uuid
  merchantId  String   @map("merchant_id") @db.Uuid
  consumerId  String   @map("consumer_id") @db.Uuid
  status      String
  firstSeenAt DateTime @default(now()) @map("first_seen_at") @db.Timestamptz(6)
  lastSeenAt  DateTime @map("last_seen_at") @db.Timestamptz(6)
  merchant    Merchant @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  consumer    Consumer @relation(fields: [consumerId], references: [id], onDelete: Restrict)

  @@unique([merchantId, consumerId])
  @@index([consumerId])
  @@map("merchant_consumer")
}

model MerchantCapability {
  merchantId        String   @id @map("merchant_id") @db.Uuid
  canCreateProduct  Boolean  @default(false) @map("can_create_product")
  canPublishProduct Boolean  @default(false) @map("can_publish_product")
  canAcceptOrder    Boolean  @default(false) @map("can_accept_order")
  canAcceptPayment  Boolean  @default(false) @map("can_accept_payment")
  canRedeemVoucher  Boolean  @default(false) @map("can_redeem_voucher")
  canProcessRefund  Boolean  @default(false) @map("can_process_refund")
  version           Int      @default(1)
  merchant          Merchant @relation(fields: [merchantId], references: [id], onDelete: Restrict)

  @@map("merchant_capability")
}

model MiniProgramAccount {
  id                     String                     @id @default(uuid()) @db.Uuid
  merchantId             String                     @map("merchant_id") @db.Uuid
  brandId                String                     @map("brand_id") @db.Uuid
  appId                  String                     @unique @map("app_id")
  authorizationStatus    String                     @map("authorization_status")
  developmentStatus      String                     @map("development_status")
  auditStatus            String                     @map("audit_status")
  releaseStatus          String                     @map("release_status")
  overallStatus          String                     @map("overall_status")
  currentTemplateVersion String?                    @map("current_template_version")
  releasedVersion        String?                    @map("released_version")
  currentConfigVersion   Int?                       @map("current_config_version")
  createdAt              DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)
  merchant               Merchant                   @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  brand                  Brand                      @relation(fields: [brandId, merchantId], references: [id, merchantId], onDelete: Restrict)
  authorizations         MiniProgramAuthorization[]
  configs                MiniProgramConfig[]
  releaseJobs            MiniProgramReleaseJob[]
  paymentAccounts        PaymentAccount[]

  @@unique([id, merchantId])
  @@index([merchantId, overallStatus])
  @@map("mini_program_account")
}

model MiniProgramAuthorization {
  id                     String             @id @default(uuid()) @db.Uuid
  miniProgramAccountId   String             @map("mini_program_account_id") @db.Uuid
  authorizationStatus    String             @map("authorization_status")
  authorizationScopeJson Json               @map("authorization_scope_json") @db.JsonB
  credentialRef          String             @map("credential_ref")
  authorizedAt           DateTime           @map("authorized_at") @db.Timestamptz(6)
  refreshedAt            DateTime?          @map("refreshed_at") @db.Timestamptz(6)
  revokedAt              DateTime?          @map("revoked_at") @db.Timestamptz(6)
  account                MiniProgramAccount @relation(fields: [miniProgramAccountId], references: [id], onDelete: Restrict)

  @@unique([miniProgramAccountId], map: "mini_program_authorization_active_key", where: raw("authorization_status = 'ACTIVE'"))
  @@index([miniProgramAccountId, authorizedAt])
  @@map("mini_program_authorization")
}

model MiniProgramConfig {
  id                   String                  @id @default(uuid()) @db.Uuid
  miniProgramAccountId String                  @map("mini_program_account_id") @db.Uuid
  merchantId           String                  @map("merchant_id") @db.Uuid
  brandId              String                  @map("brand_id") @db.Uuid
  configVersion        Int                     @map("config_version")
  configJson           Json                    @map("config_json") @db.JsonB
  status               MiniProgramConfigStatus
  publishedAt          DateTime?               @map("published_at") @db.Timestamptz(6)
  createdAt            DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  merchant             Merchant                @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  brand                Brand                   @relation(fields: [brandId, merchantId], references: [id, merchantId], onDelete: Restrict)
  account              MiniProgramAccount      @relation(fields: [miniProgramAccountId, merchantId], references: [id, merchantId], onDelete: Restrict)

  @@unique([miniProgramAccountId, configVersion])
  @@index([merchantId, status])
  @@map("mini_program_config")
}

model FeatureFlag {
  id          String  @id @default(uuid()) @db.Uuid
  scopeType   String  @map("scope_type")
  scopeId     String  @map("scope_id") @db.Uuid
  featureCode String  @map("feature_code")
  enabled     Boolean @default(false)
  configJson  Json?   @map("config_json") @db.JsonB

  @@unique([scopeType, scopeId, featureCode])
  @@map("feature_flag")
}

model MiniProgramTemplate {
  id              String                  @id @default(uuid()) @db.Uuid
  templateId      String                  @map("template_id")
  templateVersion String                  @map("template_version")
  sourceDraftId   String?                 @map("source_draft_id")
  status          String
  description     String?
  releaseJobs     MiniProgramReleaseJob[]

  @@unique([templateId, templateVersion])
  @@map("mini_program_template")
}

model MiniProgramReleaseJob {
  id                   String                      @id @default(uuid()) @db.Uuid
  miniProgramAccountId String                      @map("mini_program_account_id") @db.Uuid
  merchantId           String                      @map("merchant_id") @db.Uuid
  templateRecordId     String                      @map("template_record_id") @db.Uuid
  templateId           String                      @map("template_id")
  templateVersion      String                      @map("template_version")
  configVersion        Int                         @map("config_version")
  auditId              String?                     @map("audit_id")
  status               MiniProgramReleaseJobStatus
  attemptCount         Int                         @default(0) @map("attempt_count")
  lastError            String?                     @map("last_error")
  createdAt            DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(6)
  account              MiniProgramAccount          @relation(fields: [miniProgramAccountId, merchantId], references: [id, merchantId], onDelete: Restrict)
  merchant             Merchant                    @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  template             MiniProgramTemplate         @relation(fields: [templateRecordId], references: [id], onDelete: Restrict)

  @@index([merchantId, status, createdAt])
  @@index([miniProgramAccountId, status])
  @@map("mini_program_release_job")
}

model PaymentAccount {
  id                      String             @id @default(uuid()) @db.Uuid
  merchantId              String             @map("merchant_id") @db.Uuid
  brandId                 String             @map("brand_id") @db.Uuid
  miniProgramAccountId    String             @map("mini_program_account_id") @db.Uuid
  provider                String
  spMchid                 String             @map("sp_mchid")
  subMchid                String?            @map("sub_mchid")
  subAppid                String             @map("sub_appid")
  onboardingStatus        String             @map("onboarding_status")
  appidBindingStatus      String             @map("appid_binding_status")
  paymentPermissionStatus String             @map("payment_permission_status")
  status                  String
  credentialRef           String             @map("credential_ref")
  createdAt               DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  merchant                Merchant           @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  brand                   Brand              @relation(fields: [brandId, merchantId], references: [id, merchantId], onDelete: Restrict)
  miniProgramAccount      MiniProgramAccount @relation(fields: [miniProgramAccountId, merchantId], references: [id, merchantId], onDelete: Restrict)
  payments                Payment[]

  @@unique([id, merchantId])
  @@unique([provider, subMchid], map: "payment_account_provider_sub_mchid_key", where: raw("sub_mchid IS NOT NULL"))
  @@index([merchantId, status])
  @@map("payment_account")
}

model Product {
  id                        String             @id @default(uuid()) @db.Uuid
  merchantId                String             @map("merchant_id") @db.Uuid
  brandId                   String             @map("brand_id") @db.Uuid
  productCode               String             @map("product_code")
  productType               ProductType        @map("product_type")
  status                    String
